# Обязательно для регистрации, входа и работы с данными VIDORA.
# Используйте собственную случайную строку длиной не менее 32 символов.
APP_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@127.0.0.1:3306/vidora

# Пароль скрытой панели /admin. Если переменная не задана, используется sava123.
ADMIN_PASSWORD=sava123

# Необязательно: нужно только для входа через Kimi OAuth.
APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_APP_ID=
VITE_KIMI_AUTH_URL=
OWNER_UNION_ID=
